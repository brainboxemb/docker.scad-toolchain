TOOLCHAIN_VERSION=0.6.2

# Tool/library versions used when building the SCAD toolchain.
#
# Released repository/container tags are immutable. Do not reuse an existing
# release tag for changed image contents.
#
# OpenSCAD itself is currently sourced from the official development-snapshot
# APT repository. The published container image freezes the resolved snapshot.
PYTHONSCAD_VERSION=1.1.2
BOSL2_VERSION=2.0.752
PYBOSL2_VERSION=0.6.7
SHAPELY_VERSION=2.1.2
OPENSCAD_DOCSGEN_VERSION=2.0.55
PILLOW_VERSION=12.3.0
SCONS_VERSION=4.11.1
DRAWSVG_VERSION=2.4.2

# NopSCADlib upstream scripting dependencies (drawing/publication profile only).
IMAGEMAGICK_VERSION=7.1.2-1
COLORAMA_VERSION=0.4.6
MARKDOWN_VERSION=3.9
CODESPELL_VERSION=2.4.1
VCS2L_VERSION=1.1.7
