#!/usr/bin/env bash
set -euo pipefail

PROFILE="${SCAD_TOOLCHAIN_PROFILE:-unknown}"

echo "SCAD toolchain"
echo "=============="
printf "Profile    : %s\n" "$PROFILE"

printf "OpenSCAD   : "
openscad --version 2>&1

printf "PythonSCAD : "
if command -v pythonscad >/dev/null 2>&1; then
  pythonscad --version 2>&1
else
  echo "not installed"
fi

printf "Python     : "
python3 --version

printf "Git        : "
git --version

printf "SCons      : "
python3 -c 'import importlib.metadata as m; print(m.version("SCons"))'

printf "BOSL2      : v%s\n" "${BOSL2_VERSION:-unknown}"
printf "Dimensions : %s\n" "${OPENSCAD_NEW_DIMENSIONS_COMMIT:-not installed}"

printf "pybosl2    : "
if PYTHONPATH="${PYTHONPATH:-/opt/python-libs}" python3 -c 'import importlib.metadata as m; m.version("pybosl2")' >/dev/null 2>&1; then
  PYTHONPATH="${PYTHONPATH:-/opt/python-libs}" python3 -c 'import importlib.metadata as m; print(m.version("pybosl2"))'
else
  echo "not installed"
fi

printf "Shapely    : "
if PYTHONPATH="${PYTHONPATH:-/opt/python-libs}" python3 -c 'import importlib.metadata as m; m.version("shapely")' >/dev/null 2>&1; then
  PYTHONPATH="${PYTHONPATH:-/opt/python-libs}" python3 -c 'import importlib.metadata as m; print(m.version("shapely"))'
else
  echo "not installed"
fi

printf "docsgen    : "
python3 -c 'import importlib.metadata as m; print(m.version("openscad_docsgen"))'

printf "Pillow     : "
python3 -c 'import importlib.metadata as m; print(m.version("Pillow"))'

printf "OPENSCADPATH: %s\n" "${OPENSCADPATH:-<unset>}"
printf "BOSL2_ROOT  : %s\n" "${BOSL2_ROOT:-<unset>}"
printf "DIMENSIONS_ROOT: %s\n" "${OPENSCAD_NEW_DIMENSIONS_ROOT:-<unset>}"
printf "PYTHONPATH : %s\n" "${PYTHONPATH:-<unset>}"
