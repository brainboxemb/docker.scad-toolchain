#!/usr/bin/env bash
set -euo pipefail

PROFILE="${SCAD_TOOLCHAIN_PROFILE:-unknown}"

echo "SCAD toolchain"
echo "=============="
printf "Profile    : %s\n" "$PROFILE"
printf "Toolchain  : %s\n" "${SCAD_TOOLCHAIN_VERSION:-unknown}"

printf "OpenSCAD   : "
openscad --version 2>&1

printf "PythonSCAD : "
if command -v pythonscad >/dev/null 2>&1; then
  pythonscad --version 2>&1
else
  echo "not installed"
fi

printf "Python     : "
python3 --version

printf "Git        : "
git --version

printf "SCons      : "
python3 -c 'import importlib.metadata as m; print(m.version("SCons"))'

printf "Inkscape   : "
if command -v inkscape >/dev/null 2>&1; then
  inkscape --version 2>&1 | head -n1
else
  echo "not installed"
fi

printf "FreeCAD    : "
if command -v freecadcmd >/dev/null 2>&1; then
  freecadcmd --version 2>&1 | head -n1
else
  echo "not installed"
fi

printf "drawsvg    : "
if python3 -c 'import importlib.metadata as m; m.version("drawsvg")' >/dev/null 2>&1; then
  python3 -c 'import importlib.metadata as m; print(m.version("drawsvg"))'
else
  echo "not installed"
fi

printf "BOSL2      : v%s\n" "${BOSL2_VERSION:-unknown}"

printf "pybosl2    : "
if PYTHONPATH="${PYTHONPATH:-/opt/python-libs}" python3 -c 'import importlib.metadata as m; m.version("pybosl2")' >/dev/null 2>&1; then
  PYTHONPATH="${PYTHONPATH:-/opt/python-libs}" python3 -c 'import importlib.metadata as m; print(m.version("pybosl2"))'
else
  echo "not installed"
fi

printf "Shapely    : "
if PYTHONPATH="${PYTHONPATH:-/opt/python-libs}" python3 -c 'import importlib.metadata as m; m.version("shapely")' >/dev/null 2>&1; then
  PYTHONPATH="${PYTHONPATH:-/opt/python-libs}" python3 -c 'import importlib.metadata as m; print(m.version("shapely"))'
else
  echo "not installed"
fi

printf "docsgen    : "
python3 -c 'import importlib.metadata as m; print(m.version("openscad_docsgen"))'

printf "Pillow     : "
python3 -c 'import importlib.metadata as m; print(m.version("Pillow"))'

printf "OPENSCADPATH: %s\n" "${OPENSCADPATH:-<unset>}"
printf "BOSL2_ROOT  : %s\n" "${BOSL2_ROOT:-<unset>}"
printf "PYTHONPATH : %s\n" "${PYTHONPATH:-<unset>}"
printf "Acknowledgments TXT: %s\n" "/usr/share/doc/scad-toolchain/OPEN_SOURCE_ACKNOWLEDGMENTS.txt"
printf "Acknowledgments PDF: %s\n" "/usr/share/doc/scad-toolchain/OPEN_SOURCE_ACKNOWLEDGMENTS.pdf"
